<?xml version="1.0" encoding="utf-8"?>
<!-- WorkManager drives data freshness; updatePeriodMillis is only an OS-level backstop
     (Android clamps it to a 30-minute minimum anyway). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="120dp"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_large"
    android:previewLayout="@layout/widget_large"
    android:description="@string/widget_large_description"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen">
</appwidget-provider>
