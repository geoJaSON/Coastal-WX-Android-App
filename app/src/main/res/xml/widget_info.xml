<?xml version="1.0" encoding="utf-8"?>
<!-- WorkManager drives data freshness; updatePeriodMillis is only an OS-level backstop
     (Android clamps it to a 30-minute minimum anyway). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="54dp"
    android:targetCellWidth="3"
    android:targetCellHeight="1"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_compact"
    android:previewLayout="@layout/widget_compact"
    android:description="@string/widget_compact_description"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen">
</appwidget-provider>
