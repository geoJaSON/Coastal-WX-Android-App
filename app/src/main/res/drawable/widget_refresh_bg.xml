<?xml version="1.0" encoding="utf-8"?>
<!-- Own ripple: android:background="@android:color/transparent" left the refresh button with
     no press feedback at all, and ?android:attr ripples resolve against the host's
     DeviceDefault theme, which can be invisible on this dark ground. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33F8FAFC">
    <item android:id="@android:id/mask">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
</ripple>
